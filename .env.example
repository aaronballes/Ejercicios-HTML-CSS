# Copia este archivo a .env y rellena tus datos. El .env NUNCA se sube al repositorio.

# Opción A: lista M3U
IPTV_M3U_URL=

# Opción B: Xtream Codes (si se rellenan los tres, tiene prioridad sobre la M3U)
IPTV_XTREAM_HOST=
IPTV_XTREAM_USER=
IPTV_XTREAM_PASS=

# Contraseña para entrar en la app. Si se deja vacía, la app queda abierta.
APP_PASSWORD=
# Cadena larga y aleatoria; si se deja vacía, la sesión se pierde en cada reinicio.
APP_SECRET=
# Cada cuántas horas se vuelve a descargar la lista
IPTV_REFRESH_HOURS=6
PORT=3000
