# Copia este archivo a .env y rellena tus datos. El .env NUNCA se sube al repositorio.

# Opción A: lista M3U
IPTV_M3U_URL=

# Opción B: Xtream Codes
IPTV_XTREAM_HOST=
IPTV_XTREAM_USER=
IPTV_XTREAM_PASS=

# Guía de programación (XMLTV), opcional
IPTV_EPG_URL=

# Contraseña para entrar en la app
APP_PASSWORD=
PORT=3000
